.idea/
.DS_Store
# Env / secrets (never commit API keys)
.env
.env.*
!.env.example
# Updater signing keys. The private half lives in ~/.pixelpaw/updater.key and
# must never enter the repo — anyone holding it can sign an update that every
# install will accept and run. Only the public half belongs in tauri.conf.json.
*.key
!*.pub
# Local data
*.sqlite
*.sqlite-*

# Agent tooling: keep the dev-server definition, drop local run state
.claude/scheduled_tasks.lock
